rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(conversationId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.members;
    }
    match /conversations/{conversationId}/{objectName} {
      allow read: if isMember(conversationId);
      allow create: if isMember(conversationId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
